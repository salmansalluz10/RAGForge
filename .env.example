# ==============================================================================
# RAGForge Environment Configuration Template
# ==============================================================================

# Application
APP_ENV=development
APP_NAME="RAGForge - Document Intelligence & RAG Platform"
APP_PORT=8000
DEBUG=true

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql+psycopg://postgres:postgres@localhost:5432/ragforge
# For Docker Compose internal network: postgresql+psycopg://postgres:postgres@postgres:5432/ragforge
# For local testing without Postgres, sqlite+aiosqlite:///./test.db or sqlite:///./ragforge.db can be used as fallback
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragforge

# Authentication & Security
JWT_SECRET=ragforge_super_secret_jwt_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=26214400  # 25 MB

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Embeddings (Configurable: "gemini", "openai")
# Default: gemini with gemini-embedding-001 (768 dimensions, free-tier friendly)
# When using gemini, set EMBEDDING_API_KEY or GEMINI_API_KEY to your Google AI Studio key.
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=

# LLM (Configurable: "gemini", "openai", "mock")
# Default: gemini with gemini-2.5-flash (shares GEMINI_API_KEY with embeddings)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
