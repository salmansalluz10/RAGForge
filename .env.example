# ==============================================================================
# RAGForge Environment Configuration Template
# ==============================================================================

# Application
APP_ENV=development
APP_NAME="RAGForge - Document Intelligence & RAG Platform"
APP_PORT=8000
DEBUG=true

# Database (PostgreSQL with pgvector)
# For local Docker: postgresql+psycopg://postgres:postgres@localhost:5432/ragforge
# For Docker Compose internal network: postgresql+psycopg://postgres:postgres@postgres:5432/ragforge
# For local testing without Postgres, sqlite+aiosqlite:///./test.db or sqlite:///./ragforge.db can be used as fallback
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ragforge

# Authentication & Security
JWT_SECRET=ragforge_super_secret_jwt_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (Frontend URL)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Storage
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_BYTES=26214400  # 25 MB

# RAG & Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
SIMILARITY_THRESHOLD=0.7

# Embeddings (Configurable: "openai", "huggingface", "local_mock_or_fastembed")
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_API_KEY=your_openai_api_key_here

# LLM (Configurable: "openai", "groq", "anthropic", "gemini")
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=your_llm_api_key_here
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
